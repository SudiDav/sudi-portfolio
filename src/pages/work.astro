---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import WorkProjectCard from "../components/WorkProjectCard.astro";

const projects = [
  {
    title: "Almafrica",
    year: "almafrica.com",
    description: "Agritech platform transforming African agriculture through technology, innovation, and inclusion. Architected the mobile app, frontend, and backend.",
    tags: ["Agritech", "Mobile", "Full-Stack"],
    category: "platforms",
    image: "/images/work/almafrica.png",
    liveUrl: "https://almafrica.com",
  },
  {
    title: "IST",
    year: "ist.com",
    description: "EdTech company building school management systems for Scandinavian schools. Redeveloped the Absence module for Danish schools with a distributed team.",
    tags: ["EdTech", "SaaS"],
    category: "platforms",
    image: "/images/work/ist.png",
    liveUrl: "https://ist.com",
  },
  {
    title: "Jungle — Loan Management",
    year: "client.altech-rdc.com",
    description: "Loan asset management system for Altech Group with acquisition dashboards and sales status tracking, integrated with Xero and Telerivet for finance workflows.",
    tags: [".NET", "Xero API", "Telerivet"],
    category: "dashboards",
    image: "/images/work/jungle-lms.png",
    liveUrl: "https://client.altech-rdc.com",
  },
  {
    title: "WavesOps",
    year: "ops.wavesre.com",
    description: "Mineral dispatch and haul operations control room for mining logistics in Kolwezi, DRC — from dispatch tracking to haul cycles.",
    tags: ["Operations", "Dashboard"],
    category: "dashboards",
    image: "/images/work/wavesops.png",
    liveUrl: "https://ops.wavesre.com",
  },
  {
    title: "Altech Group",
    year: "altech-rdc.com",
    description: "DRC market leader in clean energy distribution — world-class solar products reaching Congolese households through mobile payments.",
    tags: ["Clean Energy", "Mobile Payments"],
    category: "websites",
    image: "/images/work/altech-group.png",
    liveUrl: "https://altech-rdc.com",
  },
  {
    title: "Waves Ressources",
    year: "wavesre.com",
    description: "Corporate website for a DRC mining company: exploration, exploitation, processing, commercialization, logistics, and compliance.",
    tags: ["Mining", "Corporate"],
    category: "websites",
    image: "/images/work/wavesre.png",
    liveUrl: "https://wavesre.com",
  },
  {
    title: "Amanizen",
    year: "HR & Payroll",
    description: "HR and payroll platform covering employee records, contracts, and payroll runs.",
    tags: ["HR", "Payroll"],
    category: "platforms",
  },
  {
    title: "KoolSend",
    year: "koolsend.com",
    description: "Upcoming product — currently in development.",
    tags: ["In Development"],
    category: "platforms",
  },
];
---

<Layout title="Work — Sudi David">
  <Header currentPath="/work" />

  <main>
    <section class="page-intro">
      <Breadcrumb current="Work" />
      <h1 class="page-title">Work</h1>
      <p class="page-subtitle">
        A collection of projects I've built, contributed to, or am currently working on.
      </p>

      <div class="stats">
        <div class="stat">
          <div class="stat-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"></path><path d="M12 10v6"></path><path d="m9 13 3-3 3 3"></path></svg>
          </div>
          <span class="stat-value">8</span>
          <span class="stat-label">Projects</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <div class="stat-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="18" r="3"></circle><circle cx="6" cy="6" r="3"></circle><circle cx="18" cy="6" r="3"></circle><path d="M18 9v2c0 .6-.4 1-1 1H7c-.6 0-1-.4-1-1V9"></path><path d="M12 12v3"></path></svg>
          </div>
          <span class="stat-value">6</span>
          <span class="stat-label">Companies</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <div class="stat-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2"></path></svg>
          </div>
          <span class="stat-value">9+</span>
          <span class="stat-label">Years</span>
        </div>
      </div>
    </section>

    <div class="filters">
      <button class="filter active" data-filter="all">All</button>
      <button class="filter" data-filter="platforms">Platforms</button>
      <button class="filter" data-filter="dashboards">Dashboards</button>
      <button class="filter" data-filter="websites">Websites</button>
    </div>

    <section class="projects-section">
      <div class="grid-row">
        {projects.map((project) => (
          <WorkProjectCard
            title={project.title}
            year={project.year}
            description={project.description}
            tags={project.tags}
            category={project.category}
            image={project.image}
            liveUrl={project.liveUrl}
          />
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  const filters = document.querySelectorAll<HTMLButtonElement>(".filter");
  const cards = document.querySelectorAll<HTMLElement>(".work-card");

  filters.forEach((btn) => {
    btn.addEventListener("click", () => {
      filters.forEach((f) => f.classList.remove("active"));
      btn.classList.add("active");

      const filter = btn.dataset.filter!;

      cards.forEach((card) => {
        if (filter === "all" || card.dataset.category === filter) {
          card.style.display = "";
        } else {
          card.style.display = "none";
        }
      });
    });
  });
</script>

<style>
  main {
    max-width: 1440px;
    margin: 0 auto;
  }

  .page-intro {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 64px 120px 32px;
  }

  .page-title {
    font-family: "Geist", sans-serif;
    font-size: 40px;
    font-weight: 700;
  }

  .page-subtitle {
    font-size: 16px;
    color: var(--color-text-secondary);
    max-width: 600px;
  }

  .stats {
    display: flex;
    align-items: center;
    gap: 0;
    margin-top: 8px;
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 20px 28px;
  }

  .stat-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    color: var(--color-accent);
  }

  .stat-value {
    font-family: "Geist Mono", monospace;
    font-size: 28px;
    font-weight: 700;
  }

  .stat-label {
    font-family: "Inter", sans-serif;
    font-size: 12px;
    font-weight: 500;
    color: var(--color-text-tertiary);
  }

  .stat-divider {
    width: 1px;
    height: 48px;
    background: var(--color-border);
  }

  .filters {
    display: flex;
    gap: 8px;
    padding: 0 120px 32px;
  }

  .filter {
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 500;
    border-radius: 9999px;
    background: var(--color-bg-card);
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border);
    transition:
      background-color 0.2s,
      color 0.2s;
  }

  .filter:hover {
    border-color: var(--color-border-hover);
  }

  .filter.active {
    background: var(--color-accent);
    color: #ffffff;
    border-color: var(--color-accent);
  }

  .projects-section {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 0 120px 48px;
  }

  .grid-row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  @media (max-width: 1024px) {
    .page-intro {
      padding: 48px 48px 32px;
    }

    .filters {
      padding: 0 48px 32px;
    }

    .projects-section {
      padding: 0 48px 48px;
    }
  }

  @media (max-width: 768px) {
    .page-intro {
      padding: 32px 24px 24px;
    }

    .page-title {
      font-size: 32px;
    }

    .stats {
      gap: 0;
    }

    .stat {
      padding: 16px 20px;
    }

    .stat-value {
      font-size: 22px;
    }

    .filters {
      padding: 0 24px 24px;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    .filter {
      white-space: nowrap;
    }

    .projects-section {
      padding: 0 24px 32px;
    }

    .grid-row {
      grid-template-columns: 1fr;
    }
  }
</style>

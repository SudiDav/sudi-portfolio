---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import WorkProjectCard from "../components/WorkProjectCard.astro";

const projects = [
  {
    title: "Nexus CLI",
    year: "2026",
    description: "A lightning-fast CLI tool for scaffolding full-stack apps. Supports React, Vue, and Svelte templates with built-in testing and CI configuration.",
    tags: ["Rust", "CLI", "WASM"],
    category: "cli-tools",
    sourceUrl: "#",
    liveUrl: "#",
  },
  {
    title: "Syncboard",
    year: "2026",
    description: "Real-time collaborative whiteboard with CRDT-based conflict resolution. Supports drawing, sticky notes, and live cursors for distributed teams.",
    tags: ["React", "WebSocket", "Yjs"],
    category: "web-apps",
    sourceUrl: "#",
    liveUrl: "#",
  },
  {
    title: "Datapipe",
    year: "2025",
    description: "An ETL pipeline framework for streaming data transformations at scale. Pluggable connectors for Kafka, Redis Streams, and PostgreSQL.",
    tags: ["Go", "Kafka", "gRPC"],
    category: "open-source",
    sourceUrl: "#",
    liveUrl: "#",
  },
  {
    title: "Termsync",
    year: "2025",
    description: "Terminal-based dotfile synchronization tool. Keeps dev environments consistent across machines with encrypted cloud backup.",
    tags: ["Rust", "CLI", "SSH"],
    category: "cli-tools",
    sourceUrl: "#",
    liveUrl: "#",
  },
  {
    title: "Reacton",
    year: "2024",
    description: "Lightweight state management library for React with automatic dependency tracking and zero-config persistence to localStorage.",
    tags: ["TypeScript", "React", "NPM"],
    category: "libraries",
    sourceUrl: "#",
    liveUrl: "#",
  },
  {
    title: "Infrawatch",
    year: "2024",
    description: "Self-hosted infrastructure monitoring dashboard. Tracks uptime, response times, and alerts via Slack and PagerDuty integrations.",
    tags: ["Next.js", "Docker", "Grafana"],
    category: "web-apps",
    sourceUrl: "#",
    liveUrl: "#",
  },
];
---

<Layout title="Work — Sudi David">
  <Header currentPath="/work" />

  <main>
    <section class="page-intro">
      <Breadcrumb current="Work" />
      <h1 class="page-title">Work</h1>
      <p class="page-subtitle">
        A collection of projects I've built, contributed to, or am currently working on.
      </p>

      <div class="stats">
        <div class="stat">
          <div class="stat-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"></path><path d="M12 10v6"></path><path d="m9 13 3-3 3 3"></path></svg>
          </div>
          <span class="stat-value">12</span>
          <span class="stat-label">Projects</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <div class="stat-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="18" r="3"></circle><circle cx="6" cy="6" r="3"></circle><circle cx="18" cy="6" r="3"></circle><path d="M18 9v2c0 .6-.4 1-1 1H7c-.6 0-1-.4-1-1V9"></path><path d="M12 12v3"></path></svg>
          </div>
          <span class="stat-value">8</span>
          <span class="stat-label">Open Source</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <div class="stat-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2"></path></svg>
          </div>
          <span class="stat-value">3</span>
          <span class="stat-label">Active</span>
        </div>
      </div>
    </section>

    <div class="filters">
      <button class="filter active" data-filter="all">All</button>
      <button class="filter" data-filter="web-apps">Web Apps</button>
      <button class="filter" data-filter="cli-tools">CLI Tools</button>
      <button class="filter" data-filter="libraries">Libraries</button>
      <button class="filter" data-filter="open-source">Open Source</button>
    </div>

    <section class="projects-section">
      <div class="grid-row">
        {projects.map((project) => (
          <WorkProjectCard
            title={project.title}
            year={project.year}
            description={project.description}
            tags={project.tags}
            category={project.category}
            sourceUrl={project.sourceUrl}
            liveUrl={project.liveUrl}
          />
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  const filters = document.querySelectorAll<HTMLButtonElement>(".filter");
  const cards = document.querySelectorAll<HTMLElement>(".work-card");

  filters.forEach((btn) => {
    btn.addEventListener("click", () => {
      filters.forEach((f) => f.classList.remove("active"));
      btn.classList.add("active");

      const filter = btn.dataset.filter!;

      cards.forEach((card) => {
        if (filter === "all" || card.dataset.category === filter) {
          card.style.display = "";
        } else {
          card.style.display = "none";
        }
      });
    });
  });
</script>

<style>
  main {
    max-width: 1440px;
    margin: 0 auto;
  }

  .page-intro {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 64px 120px 32px;
  }

  .page-title {
    font-family: "Geist", sans-serif;
    font-size: 40px;
    font-weight: 700;
  }

  .page-subtitle {
    font-size: 16px;
    color: var(--color-text-secondary);
    max-width: 600px;
  }

  .stats {
    display: flex;
    align-items: center;
    gap: 0;
    margin-top: 8px;
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 20px 28px;
  }

  .stat-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    color: var(--color-accent);
  }

  .stat-value {
    font-family: "Geist Mono", monospace;
    font-size: 28px;
    font-weight: 700;
  }

  .stat-label {
    font-family: "Inter", sans-serif;
    font-size: 12px;
    font-weight: 500;
    color: var(--color-text-tertiary);
  }

  .stat-divider {
    width: 1px;
    height: 48px;
    background: var(--color-border);
  }

  .filters {
    display: flex;
    gap: 8px;
    padding: 0 120px 32px;
  }

  .filter {
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 500;
    border-radius: 9999px;
    background: var(--color-bg-card);
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border);
    transition:
      background-color 0.2s,
      color 0.2s;
  }

  .filter:hover {
    border-color: var(--color-border-hover);
  }

  .filter.active {
    background: var(--color-accent);
    color: #ffffff;
    border-color: var(--color-accent);
  }

  .projects-section {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 0 120px 48px;
  }

  .grid-row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  @media (max-width: 1024px) {
    .page-intro {
      padding: 48px 48px 32px;
    }

    .filters {
      padding: 0 48px 32px;
    }

    .projects-section {
      padding: 0 48px 48px;
    }
  }

  @media (max-width: 768px) {
    .page-intro {
      padding: 32px 24px 24px;
    }

    .page-title {
      font-size: 32px;
    }

    .stats {
      gap: 0;
    }

    .stat {
      padding: 16px 20px;
    }

    .stat-value {
      font-size: 22px;
    }

    .filters {
      padding: 0 24px 24px;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    .filter {
      white-space: nowrap;
    }

    .projects-section {
      padding: 0 24px 32px;
    }

    .grid-row {
      grid-template-columns: 1fr;
    }
  }
</style>

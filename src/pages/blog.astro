---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import FeaturedBlogCard from "../components/FeaturedBlogCard.astro";
import ArticleItem from "../components/ArticleItem.astro";
import TechBadge from "../components/TechBadge.astro";

const featured = {
  title: "Observability 101: Stop Debugging in the Dark",
  excerpt: "Part 1 of a two-part series on observability: why systems without telemetry are logistics networks running blind, and the conceptual foundation to fix it.",
  date: "May 12, 2026",
  readTime: "5 min read",
  category: "OBSERVABILITY",
  image: "https://cdn.hashnode.com/uploads/covers/633c0e873851feab268a45f0/d18f630e-b1da-4e09-8c18-4a5784a9ba49.png",
  link: "https://sudi.dev/observability-101-stop-debugging-in-the-dark",
};

const articles = [
  {
    title: "The Crucial Role of English Proficiency in Software Development",
    excerpt: "A personal journey on why clear English matters as much as clean code when working on distributed, multicultural teams.",
    date: "Sep 21, 2024",
    readTime: "5 min read",
    category: "career",
    link: "https://sudi.dev/the-crucial-role-of-english-proficiency-in-software-development",
  },
  {
    title: "Code Smart, Not Fast: Avoiding Premature Optimization",
    excerpt: "Why optimizing too early keeps derailing projects, and how to focus on correctness first without painting yourself into a corner.",
    date: "Sep 14, 2024",
    readTime: "4 min read",
    category: "practices",
    link: "https://sudi.dev/code-smart-not-fast-avoiding-premature-optimization",
  },
  {
    title: "Adding Entity Framework Core and SQLite",
    excerpt: "Taking Minimal APIs to the next level by wiring up SQLite and Entity Framework Core to store and retrieve recipe data.",
    date: "Nov 14, 2023",
    readTime: "6 min read",
    category: "dotnet",
    link: "https://sudi.dev/adding-entity-framework-core-and-sqlite",
  },
  {
    title: "How to send an email with ASP.NET Core Minimal API and MailKit",
    excerpt: "Sending email from an ASP.NET Core Minimal API using MailKit, from scratch: SMTP setup, message composition, and delivery.",
    date: "Jul 10, 2023",
    readTime: "5 min read",
    category: "dotnet",
    link: "https://sudi.dev/how-to-send-an-email-with-aspnet-core-minimal-api-and-mailkit",
  },
  {
    title: "Getting started with ASP.NET Core 7 Minimal APIs",
    excerpt: "A beginner-friendly introduction to ASP.NET Core 7 Minimal APIs, building a recipe API with just a few lines of code.",
    date: "Jun 12, 2023",
    readTime: "4 min read",
    category: "dotnet",
    link: "https://sudi.dev/getting-started-with-aspnet-core-7-minimal-apis",
  },
];

const topics = [".NET", "C#", "ASP.NET Core", "Observability", "Practices", "Career"];
---

<Layout title="Blog — Sudi David">
  <Header currentPath="/blog" />

  <main>
    <section class="page-intro">
      <Breadcrumb current="Blog" />
      <h1 class="page-title">Blog</h1>
      <p class="page-subtitle">
        Thoughts on software engineering, developer tooling, and the occasional deep dive.
      </p>
    </section>

    <div class="search-filters">
      <div class="search-box">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
        <input type="text" placeholder="Search articles..." />
      </div>
      <div class="category-filters">
        <button class="filter active" data-filter="all">All</button>
        <button class="filter" data-filter="dotnet">.NET</button>
        <button class="filter" data-filter="practices">Practices</button>
        <button class="filter" data-filter="career">Career</button>
      </div>
    </div>

    <section class="featured-section">
      <span class="pinned-label">PINNED</span>
      <FeaturedBlogCard
        title={featured.title}
        excerpt={featured.excerpt}
        date={featured.date}
        readTime={featured.readTime}
        category={featured.category}
        image={featured.image}
        href={featured.link}
      />
    </section>

    <div class="blog-content">
      <section class="article-list">
        {articles.map((article) => (
          <ArticleItem
            title={article.title}
            excerpt={article.excerpt}
            date={article.date}
            readTime={article.readTime}
            data-category={article.category}
            href={article.link}
          />
        ))}
      </section>

      <aside class="blog-sidebar">
        <div class="newsletter-card">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
          <h3 class="nl-title">Stay Updated</h3>
          <p class="nl-desc">Get notified when I publish new articles. No spam, unsubscribe anytime.</p>
          <input type="email" class="nl-input" placeholder="your@email.com" />
          <button type="button" class="nl-button">Subscribe</button>
        </div>

        <div class="sidebar-section">
          <span class="sidebar-label">TOPICS</span>
          <div class="topic-tags">
            {topics.map((topic) => (
              <TechBadge label={topic} />
            ))}
          </div>
        </div>

        <div class="sidebar-section">
          <span class="sidebar-label">THIS BLOG</span>
          <div class="blog-stats">
            <div class="blog-stat-row">
              <div class="blog-stat-left">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path><path d="M14 2v4a2 2 0 0 0 2 2h4"></path><path d="M10 9H8"></path><path d="M16 13H8"></path><path d="M16 17H8"></path></svg>
                <span>Articles</span>
              </div>
              <span class="blog-stat-value">6</span>
            </div>
            <div class="blog-stat-row">
              <div class="blog-stat-left">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="10" x2="14" y1="2" y2="2"></line><line x1="12" x2="15" y1="14" y2="11"></line><circle cx="12" cy="14" r="8"></circle></svg>
                <span>Avg. Read</span>
              </div>
              <span class="blog-stat-value">5 min</span>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  const filters = document.querySelectorAll<HTMLButtonElement>(".filter");
  const articles = document.querySelectorAll<HTMLElement>(".article-item");

  filters.forEach((btn) => {
    btn.addEventListener("click", () => {
      filters.forEach((f) => f.classList.remove("active"));
      btn.classList.add("active");

      const filter = btn.dataset.filter!;

      articles.forEach((article) => {
        if (filter === "all" || article.dataset.category === filter) {
          article.style.display = "";
        } else {
          article.style.display = "none";
        }
      });
    });
  });
</script>

<style>
  main {
    max-width: 1440px;
    margin: 0 auto;
  }

  .page-intro {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 64px 120px 32px;
  }

  .page-title {
    font-family: "Geist", sans-serif;
    font-size: 40px;
    font-weight: 700;
  }

  .page-subtitle {
    font-size: 16px;
    color: var(--color-text-secondary);
    max-width: 560px;
    line-height: 1.5;
  }

  .search-filters {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding: 0 120px 32px;
  }

  .search-box {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 280px;
    padding: 10px 16px;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    color: var(--color-text-tertiary);
  }

  .search-box input {
    flex: 1;
    background: none;
    border: none;
    outline: none;
    font-size: 13px;
    color: var(--color-text-primary);
  }

  .search-box input::placeholder {
    color: var(--color-text-tertiary);
  }

  .category-filters {
    display: flex;
    gap: 8px;
  }

  .filter {
    padding: 8px 14px;
    font-size: 12px;
    font-weight: 500;
    border-radius: 9999px;
    background: var(--color-bg-card);
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border);
    transition:
      background-color 0.2s,
      color 0.2s;
  }

  .filter:hover {
    border-color: var(--color-border-hover);
  }

  .filter.active {
    background: var(--color-accent);
    color: #ffffff;
    border-color: var(--color-accent);
  }

  .featured-section {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 0 120px 40px;
  }

  .pinned-label {
    font-family: "Geist Mono", monospace;
    font-size: 11px;
    font-weight: 600;
    color: var(--color-text-tertiary);
    letter-spacing: 0.05em;
  }

  .blog-content {
    display: flex;
    gap: 48px;
    padding: 32px 120px 48px;
  }

  .article-list {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  /* ---- Sidebar ---- */

  .blog-sidebar {
    width: 300px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 32px;
    align-self: flex-start;
  }

  .newsletter-card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 24px;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    color: var(--color-accent);
  }

  .nl-title {
    font-family: "Geist", sans-serif;
    font-size: 16px;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .nl-desc {
    font-size: 13px;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  .nl-input {
    width: 100%;
    padding: 10px 14px;
    font-size: 13px;
    background: var(--color-bg-primary);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    color: var(--color-text-primary);
    outline: none;
    box-sizing: border-box;
  }

  .nl-input::placeholder {
    color: var(--color-text-tertiary);
  }

  .nl-button {
    width: 100%;
    padding: 10px 0;
    font-size: 13px;
    font-weight: 600;
    text-align: center;
    background: var(--color-accent);
    color: #ffffff;
    border-radius: 6px;
    transition: opacity 0.2s;
  }

  .nl-button:hover {
    opacity: 0.9;
  }

  .sidebar-section {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .sidebar-label {
    font-family: "Geist Mono", monospace;
    font-size: 11px;
    font-weight: 600;
    color: var(--color-text-tertiary);
    letter-spacing: 1.5px;
  }

  .topic-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .blog-stats {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .blog-stat-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .blog-stat-left {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    color: var(--color-text-secondary);
  }

  .blog-stat-left svg {
    color: var(--color-text-tertiary);
  }

  .blog-stat-value {
    font-family: "Geist Mono", monospace;
    font-size: 13px;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  /* ---- Responsive ---- */

  @media (max-width: 1024px) {
    .page-intro {
      padding: 48px 48px 32px;
    }

    .search-filters {
      padding: 0 48px 32px;
    }

    .featured-section {
      padding: 0 48px 32px;
    }

    .blog-content {
      padding: 32px 48px 48px;
    }
  }

  @media (max-width: 768px) {
    .page-intro {
      padding: 32px 24px 24px;
    }

    .page-title {
      font-size: 32px;
    }

    .search-filters {
      flex-direction: column;
      align-items: stretch;
      gap: 16px;
      padding: 0 24px 24px;
    }

    .search-box {
      width: 100%;
    }

    .category-filters {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    .filter {
      white-space: nowrap;
    }

    .featured-section {
      padding: 0 24px 32px;
    }

    .blog-content {
      flex-direction: column;
      padding: 0 24px 32px;
      gap: 32px;
    }

    .blog-sidebar {
      width: 100%;
    }
  }
</style>

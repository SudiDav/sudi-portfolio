---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import FeaturedBlogCard from "../components/FeaturedBlogCard.astro";
import ArticleItem from "../components/ArticleItem.astro";
import TechBadge from "../components/TechBadge.astro";

const featured = {
  title: "Building a Real-Time Collaboration Engine from Scratch",
  excerpt: "A deep dive into CRDTs, operational transforms, and the architecture decisions behind building conflict-free real-time editing.",
  date: "Jul 15, 2026",
  readTime: "12 min read",
  category: "DEVELOPMENT",
};

const articles = [
  {
    title: "Why I Switched from REST to tRPC",
    excerpt: "Type-safe APIs end-to-end changed how I think about client-server communication and development velocity.",
    date: "Jun 28, 2026",
    readTime: "5 min read",
    category: "development",
  },
  {
    title: "Optimizing Docker Builds for Monorepos",
    excerpt: "Cutting CI build times by 70% with multi-stage builds, BuildKit caching, and intelligent layer ordering.",
    date: "Jun 10, 2026",
    readTime: "6 min read",
    category: "devops",
  },
  {
    title: "A Practical Guide to Database Migrations",
    excerpt: "Strategies for zero-downtime schema changes in production PostgreSQL deployments at scale.",
    date: "May 22, 2026",
    readTime: "10 min read",
    category: "architecture",
  },
  {
    title: "The Case for Server Components",
    excerpt: "How React Server Components changed my mental model of frontend architecture and data fetching patterns.",
    date: "May 5, 2026",
    readTime: "7 min read",
    category: "development",
  },
  {
    title: "Designing CLI Tools That Developers Love",
    excerpt: "UX principles, progressive disclosure, and ergonomic defaults that make command-line tools a joy to use.",
    date: "Apr 18, 2026",
    readTime: "8 min read",
    category: "open-source",
  },
  {
    title: "Event Sourcing in Practice",
    excerpt: "Lessons learned from implementing event sourcing in a production fintech application over two years.",
    date: "Mar 30, 2026",
    readTime: "11 min read",
    category: "architecture",
  },
];

const topics = ["React", "TypeScript", "DevOps", "Architecture", "Rust", "Go"];
---

<Layout title="Blog — Sudi David">
  <Header currentPath="/blog" />

  <main>
    <section class="page-intro">
      <Breadcrumb current="Blog" />
      <h1 class="page-title">Blog</h1>
      <p class="page-subtitle">
        Thoughts on software engineering, developer tooling, and the occasional deep dive.
      </p>
    </section>

    <div class="search-filters">
      <div class="search-box">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
        <input type="text" placeholder="Search articles..." />
      </div>
      <div class="category-filters">
        <button class="filter active" data-filter="all">All</button>
        <button class="filter" data-filter="development">Development</button>
        <button class="filter" data-filter="devops">DevOps</button>
        <button class="filter" data-filter="architecture">Architecture</button>
        <button class="filter" data-filter="open-source">Open Source</button>
      </div>
    </div>

    <section class="featured-section">
      <span class="pinned-label">PINNED</span>
      <FeaturedBlogCard
        title={featured.title}
        excerpt={featured.excerpt}
        date={featured.date}
        readTime={featured.readTime}
        category={featured.category}
        image="/images/blog-featured.jpg"
        href="/blog/real-time-collaboration"
      />
    </section>

    <div class="blog-content">
      <section class="article-list">
        {articles.map((article) => (
          <ArticleItem
            title={article.title}
            excerpt={article.excerpt}
            date={article.date}
            readTime={article.readTime}
            data-category={article.category}
            href="/blog/real-time-collaboration"
          />
        ))}
      </section>

      <aside class="blog-sidebar">
        <div class="newsletter-card">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
          <h3 class="nl-title">Stay Updated</h3>
          <p class="nl-desc">Get notified when I publish new articles. No spam, unsubscribe anytime.</p>
          <input type="email" class="nl-input" placeholder="your@email.com" />
          <button type="button" class="nl-button">Subscribe</button>
        </div>

        <div class="sidebar-section">
          <span class="sidebar-label">TOPICS</span>
          <div class="topic-tags">
            {topics.map((topic) => (
              <TechBadge label={topic} />
            ))}
          </div>
        </div>

        <div class="sidebar-section">
          <span class="sidebar-label">THIS BLOG</span>
          <div class="blog-stats">
            <div class="blog-stat-row">
              <div class="blog-stat-left">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path><path d="M14 2v4a2 2 0 0 0 2 2h4"></path><path d="M10 9H8"></path><path d="M16 13H8"></path><path d="M16 17H8"></path></svg>
                <span>Articles</span>
              </div>
              <span class="blog-stat-value">24</span>
            </div>
            <div class="blog-stat-row">
              <div class="blog-stat-left">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="10" x2="14" y1="2" y2="2"></line><line x1="12" x2="15" y1="14" y2="11"></line><circle cx="12" cy="14" r="8"></circle></svg>
                <span>Avg. Read</span>
              </div>
              <span class="blog-stat-value">7 min</span>
            </div>
            <div class="blog-stat-row">
              <div class="blog-stat-left">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path><circle cx="12" cy="12" r="3"></circle></svg>
                <span>Total Views</span>
              </div>
              <span class="blog-stat-value">48.2K</span>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  const filters = document.querySelectorAll<HTMLButtonElement>(".filter");
  const articles = document.querySelectorAll<HTMLElement>(".article-item");

  filters.forEach((btn) => {
    btn.addEventListener("click", () => {
      filters.forEach((f) => f.classList.remove("active"));
      btn.classList.add("active");

      const filter = btn.dataset.filter!;

      articles.forEach((article) => {
        if (filter === "all" || article.dataset.category === filter) {
          article.style.display = "";
        } else {
          article.style.display = "none";
        }
      });
    });
  });
</script>

<style>
  main {
    max-width: 1440px;
    margin: 0 auto;
  }

  .page-intro {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 64px 120px 32px;
  }

  .page-title {
    font-family: "Geist", sans-serif;
    font-size: 40px;
    font-weight: 700;
  }

  .page-subtitle {
    font-size: 16px;
    color: var(--color-text-secondary);
    max-width: 560px;
    line-height: 1.5;
  }

  .search-filters {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding: 0 120px 32px;
  }

  .search-box {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 280px;
    padding: 10px 16px;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    color: var(--color-text-tertiary);
  }

  .search-box input {
    flex: 1;
    background: none;
    border: none;
    outline: none;
    font-size: 13px;
    color: var(--color-text-primary);
  }

  .search-box input::placeholder {
    color: var(--color-text-tertiary);
  }

  .category-filters {
    display: flex;
    gap: 8px;
  }

  .filter {
    padding: 8px 14px;
    font-size: 12px;
    font-weight: 500;
    border-radius: 9999px;
    background: var(--color-bg-card);
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border);
    transition:
      background-color 0.2s,
      color 0.2s;
  }

  .filter:hover {
    border-color: var(--color-border-hover);
  }

  .filter.active {
    background: var(--color-accent);
    color: #ffffff;
    border-color: var(--color-accent);
  }

  .featured-section {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 0 120px 40px;
  }

  .pinned-label {
    font-family: "Geist Mono", monospace;
    font-size: 11px;
    font-weight: 600;
    color: var(--color-text-tertiary);
    letter-spacing: 0.05em;
  }

  .blog-content {
    display: flex;
    gap: 48px;
    padding: 32px 120px 48px;
  }

  .article-list {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  /* ---- Sidebar ---- */

  .blog-sidebar {
    width: 300px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 32px;
    align-self: flex-start;
  }

  .newsletter-card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 24px;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    color: var(--color-accent);
  }

  .nl-title {
    font-family: "Geist", sans-serif;
    font-size: 16px;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .nl-desc {
    font-size: 13px;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  .nl-input {
    width: 100%;
    padding: 10px 14px;
    font-size: 13px;
    background: var(--color-bg-primary);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    color: var(--color-text-primary);
    outline: none;
    box-sizing: border-box;
  }

  .nl-input::placeholder {
    color: var(--color-text-tertiary);
  }

  .nl-button {
    width: 100%;
    padding: 10px 0;
    font-size: 13px;
    font-weight: 600;
    text-align: center;
    background: var(--color-accent);
    color: #ffffff;
    border-radius: 6px;
    transition: opacity 0.2s;
  }

  .nl-button:hover {
    opacity: 0.9;
  }

  .sidebar-section {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .sidebar-label {
    font-family: "Geist Mono", monospace;
    font-size: 11px;
    font-weight: 600;
    color: var(--color-text-tertiary);
    letter-spacing: 1.5px;
  }

  .topic-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .blog-stats {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .blog-stat-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .blog-stat-left {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    color: var(--color-text-secondary);
  }

  .blog-stat-left svg {
    color: var(--color-text-tertiary);
  }

  .blog-stat-value {
    font-family: "Geist Mono", monospace;
    font-size: 13px;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  /* ---- Responsive ---- */

  @media (max-width: 1024px) {
    .page-intro {
      padding: 48px 48px 32px;
    }

    .search-filters {
      padding: 0 48px 32px;
    }

    .featured-section {
      padding: 0 48px 32px;
    }

    .blog-content {
      padding: 32px 48px 48px;
    }
  }

  @media (max-width: 768px) {
    .page-intro {
      padding: 32px 24px 24px;
    }

    .page-title {
      font-size: 32px;
    }

    .search-filters {
      flex-direction: column;
      align-items: stretch;
      gap: 16px;
      padding: 0 24px 24px;
    }

    .search-box {
      width: 100%;
    }

    .category-filters {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    .filter {
      white-space: nowrap;
    }

    .featured-section {
      padding: 0 24px 32px;
    }

    .blog-content {
      flex-direction: column;
      padding: 0 24px 32px;
      gap: 32px;
    }

    .blog-sidebar {
      width: 100%;
    }
  }
</style>

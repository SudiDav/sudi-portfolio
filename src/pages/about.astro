---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
---

<Layout title="About — Sudi David">
  <Header currentPath="/about" />

  <main>
    <section class="page-intro">
      <Breadcrumb current="About" />
      <h1 class="page-title">About</h1>
    </section>

    <section class="hero-section">
      <div class="portrait">
        <img src="/avatar.jpg" alt="Sudi David" width="340" height="400" />
      </div>
      <div class="intro-text">
        <h2 class="headline">I build tools that make developers' lives easier.</h2>
        <p class="bio-paragraph">
          I'm a full-stack developer with a deep love for developer experience,
          open source, and building things that matter. I believe great software
          comes from understanding the people who use it.
        </p>
        <p class="bio-paragraph">
          When I'm not writing code, you'll find me contributing to open source
          projects, writing about software architecture, or exploring the
          intersection of design and engineering.
        </p>
        <div class="status-row">
          <span class="status-badge">
            <span class="status-dot"></span>
            Open to opportunities
          </span>
          <span class="location">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            Remote
          </span>
        </div>
      </div>
    </section>

    <hr class="divider" />

    <section class="experience-section">
      <span class="section-label">EXPERIENCE</span>
      <h2 class="section-title">Where I've Worked</h2>
      <div class="timeline">
        <!-- Timeline entries will go here -->
      </div>
    </section>

    <hr class="divider" />

    <section class="skills-section">
      <span class="section-label">TOOLKIT</span>
      <h2 class="section-title">Skills & Technologies</h2>
      <div class="skills-grid">
        <div class="skill-col">
          <h3 class="skill-col-title">Languages</h3>
          <!-- Skill items -->
        </div>
        <div class="skill-col">
          <h3 class="skill-col-title">Frontend</h3>
        </div>
        <div class="skill-col">
          <h3 class="skill-col-title">Backend</h3>
        </div>
        <div class="skill-col">
          <h3 class="skill-col-title">DevOps</h3>
        </div>
      </div>
    </section>

    <hr class="divider" />

    <section class="beyond-code">
      <div class="beyond-left">
        <span class="section-label">BEYOND CODE</span>
        <h2 class="section-title">When I'm Not Coding</h2>
        <p class="section-desc">
          I believe the best engineers have rich lives outside of work. Here's what fills my time when the laptop is closed.
        </p>
      </div>
      <div class="beyond-right">
        <!-- Interest cards will go here -->
      </div>
    </section>

    <section class="connect-section">
      <span class="cta-label">LET'S CONNECT</span>
      <h2 class="cta-title">Interested in working together?</h2>
      <p class="cta-desc">
        I'm always open to discussing new projects, creative ideas, or opportunities to be part of your vision.
      </p>
      <div class="cta-actions">
        <a href="mailto:hello@sudi.dev" class="btn btn-primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
          Send an Email
        </a>
        <a href="#" class="btn btn-secondary">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect><line x1="16" x2="16" y1="2" y2="6"></line><line x1="8" x2="8" y1="2" y2="6"></line><line x1="3" x2="21" y1="10" y2="10"></line></svg>
          Book a Call
        </a>
      </div>
      <div class="social-row">
        <a href="https://github.com" class="social-icon" target="_blank" rel="noopener" aria-label="GitHub">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg>
        </a>
        <a href="https://twitter.com" class="social-icon" target="_blank" rel="noopener" aria-label="Twitter">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"></path></svg>
        </a>
        <a href="https://linkedin.com" class="social-icon" target="_blank" rel="noopener" aria-label="LinkedIn">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect width="4" height="12" x="2" y="9"></rect><circle cx="4" cy="4" r="2"></circle></svg>
        </a>
        <a href="https://dribbble.com" class="social-icon" target="_blank" rel="noopener" aria-label="Dribbble">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M19.13 5.09C15.22 9.14 10 10.44 2.25 10.94"></path><path d="M21.75 12.84c-6.62-1.41-12.14 1-16.38 6.32"></path><path d="M8.56 2.75c4.37 6 6 9.42 8 17.72"></path></svg>
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  main {
    max-width: 1440px;
    margin: 0 auto;
  }

  .page-intro {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 48px 48px 32px;
  }

  .page-title {
    font-family: "Geist", sans-serif;
    font-size: 40px;
    font-weight: 700;
  }

  .hero-section {
    display: flex;
    gap: 56px;
    padding: 0 48px 48px;
  }

  .portrait {
    width: 340px;
    flex-shrink: 0;
    border-radius: 12px;
    overflow: hidden;
  }

  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .intro-text {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .headline {
    font-family: "Geist", sans-serif;
    font-size: 28px;
    font-weight: 700;
    line-height: 1.3;
  }

  .bio-paragraph {
    font-size: 15px;
    color: var(--color-text-secondary);
    line-height: 1.7;
  }

  .status-row {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: "Geist Mono", monospace;
    font-size: 12px;
    color: var(--color-text-secondary);
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #34d399;
  }

  .location {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: "Geist Mono", monospace;
    font-size: 12px;
    color: var(--color-text-tertiary);
  }

  .divider {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 0 48px;
  }

  .section-label {
    font-family: "Geist Mono", monospace;
    font-size: 11px;
    font-weight: 600;
    color: var(--color-text-tertiary);
    letter-spacing: 0.05em;
  }

  .section-title {
    font-family: "Geist", sans-serif;
    font-size: 28px;
    font-weight: 700;
  }

  .experience-section,
  .skills-section {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding: 48px;
  }

  .timeline {
    display: flex;
    flex-direction: column;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .skill-col {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 24px;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 12px;
  }

  .skill-col-title {
    font-family: "Geist", sans-serif;
    font-size: 15px;
    font-weight: 600;
  }

  .beyond-code {
    display: flex;
    gap: 56px;
    padding: 48px;
  }

  .beyond-left {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .section-desc {
    font-size: 15px;
    color: var(--color-text-secondary);
    line-height: 1.7;
  }

  .beyond-right {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .connect-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    padding: 64px 48px;
    margin: 0 48px;
    background: var(--color-bg-secondary);
    border-radius: 16px;
    text-align: center;
    margin-bottom: 48px;
  }

  .cta-label {
    font-family: "Geist Mono", monospace;
    font-size: 11px;
    font-weight: 600;
    color: var(--color-accent);
    letter-spacing: 0.05em;
  }

  .cta-title {
    font-family: "Geist", sans-serif;
    font-size: 32px;
    font-weight: 700;
  }

  .cta-desc {
    font-size: 15px;
    color: var(--color-text-secondary);
    max-width: 480px;
  }

  .cta-actions {
    display: flex;
    gap: 16px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    font-size: 14px;
    font-weight: 500;
    border-radius: 8px;
    transition:
      background-color 0.2s,
      border-color 0.2s;
  }

  .btn-primary {
    background: var(--color-accent);
    color: #ffffff;
  }

  .btn-primary:hover {
    opacity: 0.9;
  }

  .btn-secondary {
    border: 1px solid var(--color-border);
    color: var(--color-text-primary);
  }

  .btn-secondary:hover {
    border-color: var(--color-border-hover);
  }

  .social-row {
    display: flex;
    gap: 20px;
    margin-top: 8px;
  }

  .social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    transition:
      color 0.2s,
      border-color 0.2s;
  }

  .social-icon:hover {
    color: var(--color-text-primary);
    border-color: var(--color-border-hover);
  }
</style>

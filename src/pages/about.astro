---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Breadcrumb from "../components/Breadcrumb.astro";

const experience = [
  {
    role: "Senior Software Engineer",
    company: "Almafrica",
    period: "May 2026 — Present",
    description: "Architected and designed the mobile, frontend, and backend of a platform helping farmers join the world of tech — leading a team of developers and mentoring juniors.",
    current: true,
  },
  {
    role: "FullStack Engineer",
    company: "IST Africa",
    location: "Remote, Denmark",
    period: "Feb 2024 — Apr 2026",
    description: "Spearheaded the redevelopment of a comprehensive school management system for Danish schools, starting with the Absence module, while coordinating with distributed teams across regions to ensure smooth delivery.",
  },
  {
    role: "FullStack Engineer",
    company: "Altech Group",
    location: "DRC (Hybrid)",
    period: "Feb 2021 — Jan 2024",
    description: "Managed a team of 4 developers and launched a loan asset management system. Integrated third-party solutions like Spark Energy and Omnivoltaic, and streamlined finance workflows with the Xero and Telerivet APIs.",
  },
  {
    role: "FullStack Engineer",
    company: "Fintech Group",
    location: "Uganda",
    period: "Apr 2018 — Dec 2019",
    description: "Built a reporting system for AB Bank on CHEQUEPOINT that cut paperwork by 70%, automated file generation to NCBA's core banking system, and reduced hands-on reconciliations with a balance-checking web service.",
  },
  {
    role: "FullStack Engineer",
    company: "Fintech Group",
    location: "Uganda",
    period: "Feb 2017 — Mar 2018",
    description: "Integrated the central bank system with local banks through CHEQUEPOINT, and migrated the legacy system to MSSQL and ASP.NET — helping users work confidently with 85% fewer errors.",
    last: true,
  },
];

const skills = {
  Backend: [".NET C#", "ASP.NET Core", "NodeJS", "NestJS", "Microservices"],
  Frontend: ["TypeScript", "React", "Vue"],
  Data: ["SQL Server", "PostgreSQL", "MongoDB", "RabbitMQ", "GraphQL & REST"],
  DevOps: ["Docker & K8s", "AWS (EC2, S3)", "Nginx & Traefik", "GitHub Actions", "Datadog & Sentry"],
};

const background = [
  {
    title: "Education",
    description: "Sikkim Manipal University — Degree in Science of Information Technology, 2013–2017. Top 10% of my class.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"></path><path d="M22 10v6"></path><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"></path></svg>`,
  },
  {
    title: "Award",
    description: "Facebook Developer Challenge (2018) — built JusticeBot, a chatbot that simplifies legal procedure information and connects people with free legal service providers.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"></path><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"></path><path d="M4 22h16"></path><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"></path><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"></path><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"></path></svg>`,
  },
  {
    title: "Side Project",
    description: "Auction Car web app — a microservices .NET application built with RabbitMQ, Docker, and Kubernetes.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7.5 4.27 9 5.15"></path><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"></path><path d="m3.3 7 8.7 5 8.7-5"></path><path d="M12 22V12"></path></svg>`,
  },
  {
    title: "Languages",
    description: "Swahili (native), French (native), English (C2, fluent).",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 8 6 6"></path><path d="m4 14 6-6 2-3"></path><path d="M2 5h12"></path><path d="M7 2h1"></path><path d="m22 22-5-10-5 10"></path><path d="M14 18h6"></path></svg>`,
  },
];
---

<Layout title="About — Sudi David">
  <Header currentPath="/about" />

  <main>
    <section class="page-intro">
      <Breadcrumb current="About" />
      <h1 class="page-title">About</h1>
    </section>

    <section class="hero-section">
      <div class="portrait">
        <img src="/Avatar.png" alt="Sudi David" width="340" height="420" />
      </div>
      <div class="intro-text">
        <h2 class="headline">I build high-performance, scalable backend systems.</h2>
        <p class="bio-paragraph">
          I'm Sudi David — a full-stack software engineer with 9+ years of
          experience delivering end-to-end solutions across fintech, edtech, and
          enterprise domains.
        </p>
        <p class="bio-paragraph">
          Currently a Senior Software Engineer at Almafrica, building technology
          that helps farmers join the world of tech. I enjoy leading distributed
          teams, mentoring junior developers, and turning complex technical
          challenges into reliable, production-ready software.
        </p>
        <div class="status-row">
          <span class="status-badge">
            <span class="status-dot"></span>
            Available for work
          </span>
          <span class="location-badge">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            DRC
          </span>
          <a href="/Sudi-David-Resume.pdf" download class="resume-btn">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" x2="12" y1="15" y2="3"></line></svg>
            Download Resume
          </a>
        </div>
      </div>
    </section>

    <div class="divider-wrap"><hr class="divider" /></div>

    <section class="experience-section">
      <span class="section-label">EXPERIENCE</span>
      <h2 class="section-title">Where I've Worked</h2>
      <div class="timeline">
        {experience.map((entry) => (
          <div class="timeline-entry">
            <div class="timeline-line">
              <span class:list={["timeline-dot", { current: entry.current }]}></span>
              {!entry.last && <span class="timeline-connector"></span>}
            </div>
            <div class="timeline-content">
              <div class="timeline-top">
                <span class="timeline-role">{entry.role}</span>
                <span class="timeline-period">{entry.period}</span>
              </div>
              <span class="timeline-company">
                {entry.company}
                {entry.location && <span class="timeline-location">· {entry.location}</span>}
              </span>
              <p class="timeline-desc">{entry.description}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <div class="divider-wrap"><hr class="divider" /></div>

    <section class="skills-section">
      <span class="section-label">EXPERTISE</span>
      <h2 class="section-title">Skills & Technologies</h2>
      <div class="skills-grid">
        {Object.entries(skills).map(([category, items]) => (
          <div class="skill-col">
            <h3 class="skill-col-title">{category}</h3>
            <ul class="skill-list">
              {items.map((skill) => (
                <li class="skill-item">
                  <span class="skill-bullet"></span>
                  {skill}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <div class="divider-wrap"><hr class="divider" /></div>

    <section class="beyond-code">
      <div class="beyond-left">
        <span class="section-label">BACKGROUND</span>
        <h2 class="section-title">Beyond the Day Job</h2>
        <p class="section-desc">
          The education, side projects, and recognition that shaped how I build
          software — and the languages I work in every day.
        </p>
      </div>
      <div class="beyond-right">
        {background.map((item) => (
          <div class="interest-card">
            <div class="interest-icon">
              <Fragment set:html={item.icon} />
            </div>
            <div class="interest-text">
              <span class="interest-title">{item.title}</span>
              <p class="interest-desc">{item.description}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="connect-section">
      <span class="cta-label">LET'S CONNECT</span>
      <h2 class="cta-title">Interested in working together?</h2>
      <p class="cta-desc">
        I'm always open to new opportunities, collaborations, and interesting conversations.
      </p>
      <div class="cta-actions">
        <a href="mailto:contact@sudi.dev" class="btn btn-primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
          contact@sudi.dev
        </a>
        <a href="tel:+243817334881" class="btn btn-secondary">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          +243 817 334 881
        </a>
      </div>
      <div class="social-row">
        <a href="https://github.com/SudiDav" class="social-icon" target="_blank" rel="noopener" aria-label="GitHub">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg>
        </a>
        <a href="https://twitter.com/sudi_dav" class="social-icon" target="_blank" rel="noopener" aria-label="Twitter">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"></path></svg>
        </a>
        <a href="https://www.linkedin.com/in/sudi-m-david-5887b5102/" class="social-icon" target="_blank" rel="noopener" aria-label="LinkedIn">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect width="4" height="12" x="2" y="9"></rect><circle cx="4" cy="4" r="2"></circle></svg>
        </a>
        <a href="https://www.youtube.com/@sudidav" class="social-icon" target="_blank" rel="noopener" aria-label="YouTube">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"></path><path d="m10 15 5-3-5-3z"></path></svg>
        </a>
        <a href="https://hashnode.com/@sudi77" class="social-icon" target="_blank" rel="noopener" aria-label="Hashnode">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.17 3.38a4.644 4.644 0 0 0-4.34 0L4.05 6.76a4.644 4.644 0 0 0-2.17 3.62v5.24c0 1.5.82 2.88 2.17 3.62l5.78 3.38a4.644 4.644 0 0 0 4.34 0l5.78-3.38a4.644 4.644 0 0 0 2.17-3.62v-5.24c0-1.5-.82-2.88-2.17-3.62z"></path><circle cx="12" cy="12" r="3"></circle></svg>
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  main {
    max-width: 1440px;
    margin: 0 auto;
  }

  .page-intro {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 64px 120px 0;
  }

  .page-title {
    font-family: "Geist", sans-serif;
    font-size: 40px;
    font-weight: 700;
  }

  /* ---- Hero ---- */

  .hero-section {
    display: flex;
    align-items: center;
    gap: 56px;
    padding: 48px 120px;
  }

  .portrait {
    width: 340px;
    height: 420px;
    flex-shrink: 0;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--color-border);
  }

  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .intro-text {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .headline {
    font-family: "Geist", sans-serif;
    font-size: 28px;
    font-weight: 700;
    line-height: 1.3;
  }

  .bio-paragraph {
    font-size: 15px;
    color: var(--color-text-secondary);
    line-height: 1.7;
  }

  .status-row {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    font-family: "Geist Mono", monospace;
    font-size: 12px;
    font-weight: 500;
    color: var(--color-accent);
    background: var(--color-accent-dim);
    border-radius: 9999px;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .location-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    font-size: 12px;
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border);
    border-radius: 9999px;
  }

  .location-badge svg {
    color: var(--color-text-tertiary);
  }

  .resume-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    font-size: 12px;
    font-weight: 600;
    color: var(--color-text-primary);
    border: 1px solid var(--color-border);
    border-radius: 9999px;
    transition:
      color 0.2s,
      border-color 0.2s;
  }

  .resume-btn:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  /* ---- Dividers ---- */

  .divider-wrap {
    padding: 0 120px;
  }

  .divider {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 0;
  }

  /* ---- Shared Section Styles ---- */

  .section-label {
    font-family: "Geist Mono", monospace;
    font-size: 11px;
    font-weight: 600;
    color: var(--color-text-tertiary);
    letter-spacing: 1.5px;
  }

  .section-title {
    font-family: "Geist", sans-serif;
    font-size: 28px;
    font-weight: 700;
  }

  /* ---- Experience ---- */

  .experience-section {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding: 48px 120px;
  }

  .timeline {
    display: flex;
    flex-direction: column;
  }

  .timeline-entry {
    display: flex;
    gap: 24px;
  }

  .timeline-line {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 24px;
    flex-shrink: 0;
  }

  .timeline-dot {
    width: 12px;
    height: 12px;
    border-radius: 9999px;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    flex-shrink: 0;
    margin-top: 5px;
  }

  .timeline-dot.current {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  .timeline-connector {
    width: 1px;
    flex: 1;
    background: var(--color-border);
  }

  .timeline-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-bottom: 32px;
  }

  .timeline-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .timeline-role {
    font-family: "Geist", sans-serif;
    font-size: 16px;
    font-weight: 600;
  }

  .timeline-period {
    font-family: "Geist Mono", monospace;
    font-size: 12px;
    color: var(--color-text-tertiary);
  }

  .timeline-company {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-accent);
  }

  .timeline-location {
    font-weight: 400;
    color: var(--color-text-tertiary);
    margin-left: 4px;
  }

  .timeline-desc {
    font-size: 14px;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  /* ---- Skills ---- */

  .skills-section {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding: 48px 120px;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .skill-col {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 24px;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 8px;
  }

  .skill-col-title {
    font-family: "Geist", sans-serif;
    font-size: 15px;
    font-weight: 600;
  }

  .skill-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .skill-item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    color: var(--color-text-secondary);
  }

  .skill-bullet {
    width: 4px;
    height: 4px;
    border-radius: 9999px;
    background: var(--color-accent);
    flex-shrink: 0;
  }

  /* ---- Beyond Code ---- */

  .beyond-code {
    display: flex;
    gap: 56px;
    padding: 48px 120px;
  }

  .beyond-left {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 24px;
    align-self: flex-start;
  }

  .section-desc {
    font-size: 15px;
    color: var(--color-text-secondary);
    line-height: 1.7;
  }

  .beyond-right {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .interest-card {
    display: flex;
    gap: 16px;
    padding: 20px;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 8px;
  }

  .interest-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    border-radius: 8px;
    background: var(--color-accent-dim);
    color: var(--color-accent);
  }

  .interest-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .interest-title {
    font-family: "Geist", sans-serif;
    font-size: 14px;
    font-weight: 600;
  }

  .interest-desc {
    font-size: 13px;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  /* ---- Connect CTA ---- */

  .connect-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    padding: 56px 120px;
    background: var(--color-bg-secondary);
    text-align: center;
  }

  .cta-label {
    font-family: "Geist Mono", monospace;
    font-size: 11px;
    font-weight: 600;
    color: var(--color-accent);
    letter-spacing: 1.5px;
  }

  .cta-title {
    font-family: "Geist", sans-serif;
    font-size: 32px;
    font-weight: 700;
  }

  .cta-desc {
    font-size: 15px;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  .cta-actions {
    display: flex;
    gap: 16px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    font-family: "Inter", sans-serif;
    font-size: 14px;
    font-weight: 500;
    border-radius: 8px;

---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Breadcrumb from "../components/Breadcrumb.astro";

const experience = [
  {
    role: "Founder & Lead Developer",
    company: "Nexus Tools",
    period: "2024 — Present",
    description: "Building open-source developer tools including Nexus CLI, Syncboard, and Datapipe. Focused on Rust, WebAssembly, and real-time collaboration.",
    current: true,
  },
  {
    role: "Senior Infrastructure Engineer",
    company: "Vercel",
    period: "2021 — 2024",
    description: "Scaled edge infrastructure to handle 30B+ requests/month. Led the migration from legacy deployment pipeline to a new Kubernetes-based architecture.",
  },
  {
    role: "Software Engineer",
    company: "Stripe",
    period: "2019 — 2021",
    description: "Built internal developer tools for the payments team. Designed and shipped a real-time monitoring dashboard used by 200+ engineers daily.",
  },
  {
    role: "Junior Developer",
    company: "Freelance",
    period: "2018 — 2019",
    description: "Built web applications for startups and small businesses. Focused on React, Node.js, and PostgreSQL.",
    last: true,
  },
];

const skills = {
  Languages: ["Rust", "TypeScript", "Go", "Python"],
  Frontend: ["React", "Next.js", "Svelte", "Tailwind"],
  Backend: ["Node.js", "PostgreSQL", "Redis", "Kafka"],
  DevOps: ["Docker", "Kubernetes", "Terraform", "GitHub Actions"],
};

const interests = [
  {
    title: "Trail Running",
    description: "50K ultramarathon finisher. I think best when moving.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m8 3 4 8 5-5 5 15H2L8 3z"></path><path d="M4.14 15.08c2.62-1.57 5.24-1.43 7.86.42 2.74 1.94 5.49 2 8.23.19"></path></svg>`,
  },
  {
    title: "Reading",
    description: "Science fiction and systems thinking. Currently reading Designing Data-Intensive Applications.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 7v14"></path><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"></path></svg>`,
  },
  {
    title: "Photography",
    description: "Street photography on film. Shooting on a Leica M6 with Portra 400.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"></path><circle cx="12" cy="13" r="3"></circle></svg>`,
  },
  {
    title: "Music",
    description: "Amateur jazz pianist. Practicing standards and exploring improvisation.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"></path><circle cx="6" cy="18" r="3"></circle><circle cx="18" cy="16" r="3"></circle></svg>`,
  },
];
---

<Layout title="About — Sudi David">
  <Header currentPath="/about" />

  <main>
    <section class="page-intro">
      <Breadcrumb current="About" />
      <h1 class="page-title">About</h1>
    </section>

    <section class="hero-section">
      <div class="portrait">
        <img src="/Avatar.png" alt="Sudi David" width="340" height="420" />
      </div>
      <div class="intro-text">
        <h2 class="headline">I build tools that make developers' lives easier.</h2>
        <p class="bio-paragraph">
          I'm Sudi David — a full-stack developer based in San Francisco with a deep
          interest in developer experience, performance engineering, and open source.
          I've spent the last 8 years building products at the intersection of
          infrastructure and developer tooling.
        </p>
        <p class="bio-paragraph">
          Currently, I'm focused on building Nexus CLI and contributing to the Rust
          ecosystem. Previously, I helped scale infrastructure at Vercel and built
          internal tooling at Stripe.
        </p>
        <div class="status-row">
          <span class="status-badge">
            <span class="status-dot"></span>
            Available for work
          </span>
          <span class="location-badge">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            San Francisco, CA
          </span>
        </div>
      </div>
    </section>

    <div class="divider-wrap"><hr class="divider" /></div>

    <section class="experience-section">
      <span class="section-label">EXPERIENCE</span>
      <h2 class="section-title">Where I've Worked</h2>
      <div class="timeline">
        {experience.map((entry) => (
          <div class="timeline-entry">
            <div class="timeline-line">
              <span class:list={["timeline-dot", { current: entry.current }]}></span>
              {!entry.last && <span class="timeline-connector"></span>}
            </div>
            <div class="timeline-content">
              <div class="timeline-top">
                <span class="timeline-role">{entry.role}</span>
                <span class="timeline-period">{entry.period}</span>
              </div>
              <span class="timeline-company">{entry.company}</span>
              <p class="timeline-desc">{entry.description}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <div class="divider-wrap"><hr class="divider" /></div>

    <section class="skills-section">
      <span class="section-label">EXPERTISE</span>
      <h2 class="section-title">Skills & Technologies</h2>
      <div class="skills-grid">
        {Object.entries(skills).map(([category, items]) => (
          <div class="skill-col">
            <h3 class="skill-col-title">{category}</h3>
            <ul class="skill-list">
              {items.map((skill) => (
                <li class="skill-item">
                  <span class="skill-bullet"></span>
                  {skill}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <div class="divider-wrap"><hr class="divider" /></div>

    <section class="beyond-code">
      <div class="beyond-left">
        <span class="section-label">BEYOND CODE</span>
        <h2 class="section-title">When I'm Not Coding</h2>
        <p class="section-desc">
          I believe great software comes from well-rounded thinking. Outside of
          work, I explore other creative and physical outlets that keep me energized
          and inspired.
        </p>
      </div>
      <div class="beyond-right">
        {interests.map((interest) => (
          <div class="interest-card">
            <div class="interest-icon">
              <Fragment set:html={interest.icon} />
            </div>
            <div class="interest-text">
              <span class="interest-title">{interest.title}</span>
              <p class="interest-desc">{interest.description}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="connect-section">
      <span class="cta-label">LET'S CONNECT</span>
      <h2 class="cta-title">Interested in working together?</h2>
      <p class="cta-desc">
        I'm always open to new opportunities, collaborations, and interesting conversations.
      </p>
      <div class="cta-actions">
        <a href="mailto:hello@sudi.dev" class="btn btn-primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
          Get in Touch
        </a>
        <a href="#" class="btn btn-secondary">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect><line x1="16" x2="16" y1="2" y2="6"></line><line x1="8" x2="8" y1="2" y2="6"></line><line x1="3" x2="21" y1="10" y2="10"></line></svg>
          Schedule a Call
        </a>
      </div>
      <div class="social-row">
        <a href="https://github.com/SudiDav" class="social-icon" target="_blank" rel="noopener" aria-label="GitHub">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg>
        </a>
        <a href="https://twitter.com/sudi_dav" class="social-icon" target="_blank" rel="noopener" aria-label="Twitter">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"></path></svg>
        </a>
        <a href="https://www.linkedin.com/in/sudi-m-david-5887b5102/" class="social-icon" target="_blank" rel="noopener" aria-label="LinkedIn">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect width="4" height="12" x="2" y="9"></rect><circle cx="4" cy="4" r="2"></circle></svg>
        </a>
        <a href="https://www.youtube.com/@sudidav" class="social-icon" target="_blank" rel="noopener" aria-label="YouTube">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"></path><path d="m10 15 5-3-5-3z"></path></svg>
        </a>
        <a href="https://hashnode.com/@sudi77" class="social-icon" target="_blank" rel="noopener" aria-label="Hashnode">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.17 3.38a4.644 4.644 0 0 0-4.34 0L4.05 6.76a4.644 4.644 0 0 0-2.17 3.62v5.24c0 1.5.82 2.88 2.17 3.62l5.78 3.38a4.644 4.644 0 0 0 4.34 0l5.78-3.38a4.644 4.644 0 0 0 2.17-3.62v-5.24c0-1.5-.82-2.88-2.17-3.62z"></path><circle cx="12" cy="12" r="3"></circle></svg>
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  main {
    max-width: 1440px;
    margin: 0 auto;
  }

  .page-intro {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 64px 120px 0;
  }

  .page-title {
    font-family: "Geist", sans-serif;
    font-size: 40px;
    font-weight: 700;
  }

  /* ---- Hero ---- */

  .hero-section {
    display: flex;
    align-items: center;
    gap: 56px;
    padding: 48px 120px;
  }

  .portrait {
    width: 340px;
    height: 420px;
    flex-shrink: 0;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--color-border);
  }

  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .intro-text {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .headline {
    font-family: "Geist", sans-serif;
    font-size: 28px;
    font-weight: 700;
    line-height: 1.3;
  }

  .bio-paragraph {
    font-size: 15px;
    color: var(--color-text-secondary);
    line-height: 1.7;
  }

  .status-row {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    font-family: "Geist Mono", monospace;
    font-size: 12px;
    font-weight: 500;
    color: var(--color-accent);
    background: var(--color-accent-dim);
    border-radius: 9999px;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .location-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    font-size: 12px;
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border);
    border-radius: 9999px;
  }

  .location-badge svg {
    color: var(--color-text-tertiary);
  }

  /* ---- Dividers ---- */

  .divider-wrap {
    padding: 0 120px;
  }

  .divider {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 0;
  }

  /* ---- Shared Section Styles ---- */

  .section-label {
    font-family: "Geist Mono", monospace;
    font-size: 11px;
    font-weight: 600;
    color: var(--color-text-tertiary);
    letter-spacing: 1.5px;
  }

  .section-title {
    font-family: "Geist", sans-serif;
    font-size: 28px;
    font-weight: 700;
  }

  /* ---- Experience ---- */

  .experience-section {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding: 48px 120px;
  }

  .timeline {
    display: flex;
    flex-direction: column;
  }

  .timeline-entry {
    display: flex;
    gap: 24px;
  }

  .timeline-line {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 24px;
    flex-shrink: 0;
  }

  .timeline-dot {
    width: 12px;
    height: 12px;
    border-radius: 9999px;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    flex-shrink: 0;
    margin-top: 5px;
  }

  .timeline-dot.current {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  .timeline-connector {
    width: 1px;
    flex: 1;
    background: var(--color-border);
  }

  .timeline-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-bottom: 32px;
  }

  .timeline-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .timeline-role {
    font-family: "Geist", sans-serif;
    font-size: 16px;
    font-weight: 600;
  }

  .timeline-period {
    font-family: "Geist Mono", monospace;
    font-size: 12px;
    color: var(--color-text-tertiary);
  }

  .timeline-company {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-accent);
  }

  .timeline-desc {
    font-size: 14px;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  /* ---- Skills ---- */

  .skills-section {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding: 48px 120px;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .skill-col {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 24px;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 8px;
  }

  .skill-col-title {
    font-family: "Geist", sans-serif;
    font-size: 15px;
    font-weight: 600;
  }

  .skill-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .skill-item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    color: var(--color-text-secondary);
  }

  .skill-bullet {
    width: 4px;
    height: 4px;
    border-radius: 9999px;
    background: var(--color-accent);
    flex-shrink: 0;
  }

  /* ---- Beyond Code ---- */

  .beyond-code {
    display: flex;
    gap: 56px;
    padding: 48px 120px;
  }

  .beyond-left {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 24px;
    align-self: flex-start;
  }

  .section-desc {
    font-size: 15px;
    color: var(--color-text-secondary);
    line-height: 1.7;
  }

  .beyond-right {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .interest-card {
    display: flex;
    gap: 16px;
    padding: 20px;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 8px;
  }

  .interest-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    border-radius: 8px;
    background: var(--color-accent-dim);
    color: var(--color-accent);
  }

  .interest-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .interest-title {
    font-family: "Geist", sans-serif;
    font-size: 14px;
    font-weight: 600;
  }

  .interest-desc {
    font-size: 13px;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  /* ---- Connect CTA ---- */

  .connect-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    padding: 56px 120px;
    background: var(--color-bg-secondary);
    text-align: center;
  }

  .cta-label {
    font-family: "Geist Mono", monospace;
    font-size: 11px;
    font-weight: 600;
    color: var(--color-accent);
    letter-spacing: 1.5px;
  }

  .cta-title {
    font-family: "Geist", sans-serif;
    font-size: 32px;
    font-weight: 700;
  }

  .cta-desc {
    font-size: 15px;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  .cta-actions {
    display: flex;
    gap: 16px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    font-family: "Inter", sans-serif;
    font-size: 14px;
    font-weight: 500;
    border-radius: 8px;
    transition:
      background-color 0.2s,
      border-color 0.2s;
  }

  .btn-primary {
    background: var(--color-accent);
    color: #ffffff;
    font-weight: 600;
  }

  .btn-primary:hover {
    opacity: 0.9;
  }

  .btn-secondary {
    border: 1px solid var(--color-border);
    color: var(--color-text-primary);
  }

  .btn-secondary:hover {
    border-color: var(--color-border-hover);
  }

  .social-row {
    display: flex;
    gap: 20px;
    margin-top: 8px;
  }

  .social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    transition:
      color 0.2s,
      border-color 0.2s;
  }

  .social-icon:hover {
    color: var(--color-text-primary);
    border-color: var(--color-border-hover);
  }

  /* ---- Responsive ---- */

  @media (max-width: 1024px) {
    .page-intro {
      padding: 48px 48px 32px;
    }

    .hero-section {
      padding: 48px;
    }

    .divider-wrap {
      padding: 0 48px;
    }

    .experience-section,
    .skills-section {
      padding: 48px;
    }

    .skills-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .beyond-code {
      padding: 48px;
    }

    .connect-section {
      padding: 56px 48px;
    }
  }

  @media (max-width: 768px) {
    .page-intro {
      padding: 32px 24px 24px;
    }

    .page-title {
      font-size: 32px;
    }

    .hero-section {
      flex-direction: column;
      padding: 0 24px 32px;
      gap: 32px;
    }

    .portrait {
      width: 100%;
      height: 300px;
    }

    .headline {
      font-size: 22px;
    }

    .status-row {
      flex-wrap: wrap;
    }

    .divider-wrap {
      padding: 0 24px;
    }

    .experience-section,
    .skills-section {
      padding: 32px 24px;
    }

    .section-title {
      font-size: 22px;
    }

    .timeline-top {
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
    }

    .skills-grid {
      grid-template-columns: 1fr;
    }

    .beyond-code {
      flex-direction: column;
      padding: 32px 24px;
      gap: 32px;
    }

    .connect-section {
      padding: 40px 24px;

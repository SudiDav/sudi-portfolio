---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ArticleItem from "../components/ArticleItem.astro";
import TechBadge from "../components/TechBadge.astro";

const projects = [
  {
    title: "Almafrica",
    description: "Agritech platform helping farmers join the world of tech — architected the mobile app, frontend, and backend.",
    tags: ["Agritech", "Full-Stack"],
  },
  {
    title: "Jungle — Loan Management",
    description: "Loan asset management system for Altech Group, integrated with Xero and Telerivet.",
    tags: [".NET", "Fintech"],
  },
  {
    title: "WavesOps",
    description: "Mineral dispatch and haul operations control room for mining logistics in Kolwezi, DRC.",
    tags: ["Operations", "Dashboard"],
  },
];

const articles = [
  {
    title: "Observability 101: Stop Debugging in the Dark",
    excerpt: "Why systems without telemetry are logistics networks running blind, and the conceptual foundation to fix it.",
    date: "May 12, 2026",
    readTime: "5 min read",
    link: "https://sudi.dev/observability-101-stop-debugging-in-the-dark",
  },
  {
    title: "The Crucial Role of English Proficiency in Software Development",
    excerpt: "Why clear English matters as much as clean code when working on distributed, multicultural teams.",
    date: "Sep 21, 2024",
    readTime: "5 min read",
    link: "https://sudi.dev/the-crucial-role-of-english-proficiency-in-software-development",
  },
  {
    title: "Code Smart, Not Fast: Avoiding Premature Optimization",
    excerpt: "Why optimizing too early keeps derailing projects, and how to focus on correctness first.",
    date: "Sep 14, 2024",
    readTime: "4 min read",
    link: "https://sudi.dev/code-smart-not-fast-avoiding-premature-optimization",
  },
  {
    title: "Adding Entity Framework Core and SQLite",
    excerpt: "Wiring up SQLite and Entity Framework Core to store and retrieve data in a Minimal API.",
    date: "Nov 14, 2023",
    readTime: "6 min read",
    link: "https://sudi.dev/adding-entity-framework-core-and-sqlite",
  },
];
---

<Layout title="Sudi David — Full-Stack Developer">
  <Header currentPath="/" />

  <main>
    <section class="hero">
      <div class="terminal-line">
        <span class="prompt">~$</span>
        <span class="command">whoami</span>
      </div>
      <h1 class="greeting">Hi, I'm Sudi David</h1>
      <p class="role">Full-Stack Developer & Open Source Enthusiast</p>
      <div class="hero-actions">
        <a href="/work" class="btn btn-primary">View My Work</a>
        <a href="/blog" class="btn btn-secondary">Read Blog</a>
      </div>

      <div class="code-snippet code-snippet-1" aria-hidden="true">
        <code><span class="keyword">// Life.cs</span></code>
        <code><span class="keyword">while</span> (Life.IsRunning) &#123;</code>
        <code>&nbsp; <span class="keyword">if</span> (!IsCoding)</code>
        <code>&nbsp; &nbsp; <span class="keyword">await</span> <span class="accent">TouchGrass</span>();</code>
        <code>&#125;</code>
      </div>
      <div class="code-snippet code-snippet-2" aria-hidden="true">
        <code>const dev = &#123;</code>
        <code class="accent">&nbsp; name: "Sudi",</code>
        <code class="accent">&nbsp; loves: "clean code",</code>
        <code class="accent">&nbsp; coffee: true,</code>
        <code>&#125;;</code>
      </div>
    </section>

    <div class="content-area">
      <aside class="sidebar">
        <div class="avatar">
          <img src="/Avatar.png" alt="Sudi David" width="120" height="120" />
        </div>
        <div class="status">
          <span class="status-dot"></span>
          <span class="status-text">Available for work</span>
        </div>
        <p class="bio">
          Building things for the web. Passionate about developer tools,
          performance, and clean architecture.
        </p>
        <div class="tech-stack">
          <span class="tech-label">TECH STACK</span>
          <div class="tech-row">
            <TechBadge label=".NET C#" />
            <TechBadge label="TypeScript" />
          </div>
          <div class="tech-row">
            <TechBadge label="NodeJS" />
            <TechBadge label="React" />
            <TechBadge label="Vue" />
          </div>
          <div class="tech-row">
            <TechBadge label="PostgreSQL" />
            <TechBadge label="Docker" />
          </div>
        </div>
        <div class="socials">
          <a href="https://github.com/SudiDav" class="social-btn" target="_blank" rel="noopener" aria-label="GitHub">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg>
          </a>
          <a href="https://twitter.com/sudi_dav" class="social-btn" target="_blank" rel="noopener" aria-label="Twitter">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"></path></svg>
          </a>
          <a href="https://www.linkedin.com/in/sudi-m-david-5887b5102/" class="social-btn" target="_blank" rel="noopener" aria-label="LinkedIn">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect width="4" height="12" x="2" y="9"></rect><circle cx="4" cy="4" r="2"></circle></svg>
          </a>
        </div>
      </aside>

      <section class="main-content">
        <div class="featured-projects">
          <div class="section-header">
            <h2 class="section-title">Featured Projects</h2>
            <a href="/work" class="view-all">View all &rarr;</a>
          </div>
          <div class="projects-grid">
            {projects.map((project) => (
              <ProjectCard
                title={project.title}
                description={project.description}
                tags={project.tags}
              />
            ))}
          </div>
        </div>

        <div class="latest-articles">
          <div class="section-header">
            <h2 class="section-title">Latest Articles</h2>
            <a href="/blog" class="view-all">View all &rarr;</a>
          </div>
          <div class="articles-list">
            {articles.map((article) => (
              <ArticleItem
                title={article.title}
                excerpt={article.excerpt}
                date={article.date}
                readTime={article.readTime}
                href={article.link}
              />
            ))}
          </div>
        </div>
      </section>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  main {
    max-width: 1440px;
    margin: 0 auto;
  }

  /* ---- Hero ---- */

  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 80px 48px 64px;
    overflow: hidden;
  }

  .terminal-line {
    display: flex;
    gap: 8px;
    font-family: "Geist Mono", monospace;
    font-size: 14px;
  }

  .prompt {
    color: var(--color-accent);
  }

  .command {
    color: var(--color-text-tertiary);
  }

  .greeting {
    font-family: "Geist", sans-serif;
    font-size: 52px;
    font-weight: 700;
    line-height: 1.1;
  }

  .role {
    font-size: 20px;
    color: var(--color-text-secondary);
    line-height: 1.4;
  }

  .hero-actions {
    display: flex;
    gap: 16px;
    align-items: center;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 10px 20px;
    font-size: 14px;
    font-weight: 600;
    border-radius: 8px;
    transition:
      background-color 0.2s,
      border-color 0.2s;
  }

  .btn-primary {
    background: var(--color-accent);
    color: #ffffff;
  }

  .btn-primary:hover {
    opacity: 0.9;
  }

  .btn-secondary {
    border: 1px solid var(--color-border);
    color: var(--color-text-primary);
  }

  .btn-secondary:hover {
    border-color: var(--color-border-hover);
  }

  .code-snippet {
    position: absolute;
    opacity: 0.5;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px 20px;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    box-shadow: 0 4px 16px rgb(0 0 0 / 0.08);
    font-family: "Geist Mono", monospace;
    font-size: 12px;
    color: var(--color-text-secondary);
    pointer-events: none;
  }

  .code-snippet .accent {
    color: var(--color-accent);
  }

  .code-snippet .keyword {
    color: var(--color-text-tertiary);
  }

  .code-snippet-1 {
    right: 320px;
    top: 40px;
  }

  .code-snippet-2 {
    right: 200px;
    top: 200px;
  }

  /* ---- Content Area: Sidebar + Main ---- */

  .content-area {
    display: flex;
    gap: 48px;
    padding: 0 48px;
  }

  .sidebar {
    width: 260px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding: 32px 32px 32px 0;
    border-right: 1px solid var(--color-border);
  }

  .avatar img {
    width: 120px;
    height: 120px;
    border-radius: 9999px;
    border: 1px solid var(--color-border);
    object-fit: cover;
    object-position: center top;
  }

  .status {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .status-text {
    font-family: "Geist Mono", monospace;
    font-size: 12px;
    color: var(--color-text-tertiary);
  }

  .bio {
    font-size: 14px;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .tech-stack {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .tech-label {
    font-family: "Geist Mono", monospace;
    font-size: 11px;
    font-weight: 600;
    color: var(--color-text-tertiary);
    letter-spacing: 1.5px;
  }

  .tech-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .socials {
    display: flex;
    gap: 16px;
  }

  .social-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    transition:
      color 0.2s,
      border-color 0.2s;
  }

  .social-btn:hover {
    color: var(--color-text-primary);
    border-color: var(--color-border-hover);
  }

  /* ---- Main Content ---- */

  .main-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 48px;
    padding: 32px 0 48px;
    min-width: 0;
  }

  .featured-projects,
  .latest-articles {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .latest-articles {
    gap: 4px;
  }

  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0;
  }

  .latest-articles .section-header {
    padding-bottom: 16px;
  }

  .section-title {
    font-family: "Geist", sans-serif;
    font-size: 24px;
    font-weight: 700;
  }

  .view-all {
    font-size: 13px;
    font-weight: 500;
    color: var(--color-accent);
    transition: opacity 0.2s;
  }

  .view-all:hover {
    opacity: 0.8;
  }

  .projects-grid {
    display: flex;
    gap: 16px;
  }

  .projects-grid > :global(*) {
    flex: 1;
    min-width: 0;
  }

  .articles-list {
    display: flex;
    flex-direction: column;
  }

  /* ---- Responsive ---- */

  @media (max-width: 1024px) {
    .code-snippet {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .hero {
      padding: 40px 24px 32px;
    }

    .greeting {
      font-size: 36px;
    }

    .role {
      font-size: 16px;
    }

    .content-area {
      flex-direction: column;
      padding: 0 24px;
      gap: 0;
    }

    .sidebar {
      width: 100%;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 16px;
      padding: 24px 0;
      border-right: none;
      border-bottom: 1px solid var(--color-border);
      align-items: center;
    }

    .tech-stack {
      width: 100%;
    }

    .socials {
      width: 100%;
    }

    .main-content {
      gap: 32px;
    }

    .projects-grid {
      flex-direction: column;
    }

    .section-title {
      font-size: 20px;
    }
  }
</style>

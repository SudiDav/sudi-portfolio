<style>
  .footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 32px 48px;
    border-top: 1px solid var(--color-border);
  }

  .copyright {
    font-family: "Geist Mono", monospace;
    font-size: 12px;
    color: var(--color-text-tertiary);
  }

  .footer-right {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .footer-link {
    font-size: 13px;
    color: var(--color-text-secondary);
    transition: color 0.2s;
  }

  .footer-link:hover {
    color: var(--color-text-primary);
  }

  .footer-socials {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .footer-socials a {
    color: var(--color-text-tertiary);
    transition: color 0.2s;
  }

  .footer-socials a:hover {
    color: var(--color-text-primary);
  }
</style>
